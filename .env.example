# Database URL: defaults to local SQLite for zero-DevOps dev; switch to PostgreSQL+pgvector in production.
DATABASE_URL=sqlite:///./data/ielts_lab.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ielts_lab

# Gemini API configuration (optional for Reading/Listening; enables live AI distractor explanations & Gemini TTS)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-4-neon

# Backend & Frontend URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty to use built-in Next.js /api/* routes on port 3000 (required for Google AI Studio).
# Set to http://localhost:8000 only when running the optional Python FastAPI server locally.
NEXT_PUBLIC_API_URL=

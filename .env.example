# Database URL: defaults to local SQLite for zero-DevOps dev; switch to PostgreSQL+pgvector in production.
DATABASE_URL=sqlite:///./data/ielts_lab.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ielts_lab

# Gemini API configuration (optional for Milestone 1; enables live Voice-to-Note parsing & AI distractor explanations)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-4-hydrogen
GEMINI_PRO_MODEL=gemini-4-neon

# Backend & Frontend URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
